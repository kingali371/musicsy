{
    "name": "cr-d-music",
    "description": "A Telegram Music Player Bot, written in Python with Pyrogram and Py-Tgcalls.",
    "logo": "https://telegra.ph/file/56d1760224589ee370186.jpg",
    "repository": "https://github.com/username/cr-d-music",
    "keywords": [
        "telegram",
        "music",
        "bot",
        "python",
        "pyrogram",
        "music-bot"
    ],
    "env": {
        "API_ID": {
            "description": "Get this value from https://my.telegram.org/apps",
            "required": true,
            "value": ""
        },
        "API_HASH": {
            "description": "Get this value from https://my.telegram.org/apps",
            "required": true,
            "value": ""
        },
        "BOT_TOKEN": {
            "description": "Your bot token from @BotFather on Telegram",
            "required": true,
            "value": ""
        },
        "MONGO_DB_URI": {
            "description": "MongoDB connection URI",
            "required": true,
            "value": "mongodb+srv://bot_vambir:Al2552001@cluster0.heabj.mongodb.net/vambir_bot?retryWrites=true&w=majority"
        },
        "MUSIC_BOT_NAME": {
            "description": "Name of your music bot",
            "required": true,
            "value": "cr ダ ᴍᴜsɪᴄ"
        },
        "OWNER_ID": {
            "description": "Your Telegram user ID (owner of the bot)",
            "required": true,
            "value": ""
        },
        "STRING_SESSION": {
            "description": "Pyrogram string session for assistant account",
            "required": true,
            "value": ""
        },
        "LOG_GROUP_ID": {
            "description": "Group ID where bot logs will be sent (bot must be admin)",
            "required": true,
            "value": ""
        }
    },
    "buildpacks": [
        {
            "url": "heroku/python"
        },
        {
            "url": "heroku/nodejs"
        },
        {
            "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
        }
    ],
    "stack": "container",
    "formation": {
        "web": {
            "quantity": 1,
            "size": "free"
        }
    }
}
